{
  "name": "lana-ws",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@prettier/plugin-oxc": "^0.2.2",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@salesforce/playwright-vscode-ext": "^1.3.10",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/test-web": "^0.0.81",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.1",
    "rollup": "^4.62.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-swc3": "^0.12.1",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.65.0",
    "wireit": "^0.14.13"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "bump-prerelease": "node ./scripts/pre-release.mjs",
    "build": "wireit",
    "build:fast": "wireit",
    "build:dev": "wireit",
    "build:dev:fast": "wireit",
    "watch": "wireit",
    "watch:fast": "rolldown -w -c rolldown.config.ts",
    "copy:package-docs": "node ./scripts/copy-package-docs.mjs",
    "typecheck": "wireit",
    "typecheck:tsc6": "tsc6 -b",
    "lint": "concurrently -r -g 'eslint . --cache --cache-location node_modules/.cache/eslint/' 'prettier --cache **/*.{ts,css,md,scss} --check --experimental-cli' 'pnpm run typecheck'",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:e2e:web": "pnpm build && playwright test --config=lana/test/playwright/playwright.config.web.ts",
    "test:e2e:desktop": "pnpm build && playwright test --config=lana/test/playwright/playwright.config.desktop.ts",
    "test:distribution-policy": "node ./scripts/verify-web-distribution.mjs",
    "ci:install": "pnpm install --frozen-lockfile --prefer-offline --ignore-scripts",
    "prettier-format": "prettier '**/*.ts' --cache --write --experimental-cli"
  },
  "lint-staged": {
    "*.{ts,css,md,scss}": "prettier --cache --write --experimental-cli"
  },
  "wireit": {
    "build": {
      "command": "rollup -c rollup.config.mjs",
      "dependencies": [
        "typecheck"
      ],
      "env": {
        "NODE_ENV": "production"
      },
      "files": [
        "apex-log-parser/src/**/*.ts",
        "lana/src/**/*",
        "lana/salesforce-icon.png",
        "lana/tsconfig.json",
        "log-viewer/src/**/*",
        "log-viewer/index.html",
        "log-viewer/tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "rollup.config.mjs",
        "scripts/**/*"
      ],
      "output": [
        "lana/dist/**",
        "log-viewer/out/**"
      ]
    },
    "build:fast": {
      "command": "rolldown -c rolldown.config.ts",
      "dependencies": [
        "typecheck"
      ],
      "env": {
        "NODE_ENV": "production"
      },
      "files": [
        "apex-log-parser/src/**/*.ts",
        "lana/src/**/*",
        "lana/salesforce-icon.png",
        "lana/tsconfig.json",
        "log-viewer/src/**/*",
        "log-viewer/index.html",
        "log-viewer/tsconfig.json",
        "package.json",
        "pnpm-lock.yaml",
        "rolldown.config.ts",
        "scripts/**/*"
      ],
      "output": [
        "lana/dist/**",
        "log-viewer/out/**"
      ]
    },
    "build:dev": {
      "command": "rollup -c rollup.config.mjs",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "apex-log-parser/src/**/*.ts",
        "lana/src/**/*",
        "lana/salesforce-icon.png",
        "lana/tsconfig-dev.json",
        "log-viewer/src/**/*",
        "log-viewer/index.html",
        "log-viewer/tsconfig-dev.json",
        "package.json",
        "pnpm-lock.yaml",
        "rollup.config.mjs",
        "scripts/**/*"
      ],
      "output": [
        "lana/dist/**",
        "log-viewer/out/**"
      ]
    },
    "watch": {
      "command": "rollup -c rollup.config.mjs",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "apex-log-parser/src/**/*.ts",
        "lana/src/**/*",
        "lana/salesforce-icon.png",
        "lana/tsconfig-dev.json",
        "log-viewer/src/**/*",
        "log-viewer/index.html",
        "log-viewer/tsconfig-dev.json",
        "package.json",
        "pnpm-lock.yaml",
        "rollup.config.mjs",
        "scripts/**/*"
      ],
      "output": [
        "lana/dist/**",
        "log-viewer/out/**"
      ]
    },
    "build:dev:fast": {
      "command": "rolldown -c rolldown.config.ts",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "apex-log-parser/src/**/*.ts",
        "lana/src/**/*",
        "lana/salesforce-icon.png",
        "lana/tsconfig-dev.json",
        "log-viewer/src/**/*",
        "log-viewer/index.html",
        "log-viewer/tsconfig-dev.json",
        "package.json",
        "pnpm-lock.yaml",
        "rolldown.config.ts",
        "scripts/**/*"
      ],
      "output": [
        "lana/dist/**",
        "log-viewer/out/**"
      ]
    },
    "typecheck": {
      "command": "tsc -b",
      "files": [
        "apex-log-parser/src/**/*.ts",
        "apex-log-parser/tsconfig.json",
        "lana/src/**/*.ts",
        "lana/tsconfig.json",
        "lana/test/playwright/**/*.ts",
        "lana/test/playwright/tsconfig.json",
        "log-viewer/src/**/*.ts",
        "log-viewer/tsconfig.json",
        "tsconfig.json"
      ],
      "output": [
        "apex-log-parser/dist/**",
        "apex-log-parser/tsconfig.tsbuildinfo",
        "lana/tsconfig.tsbuildinfo",
        "lana/test/playwright/tsconfig.tsbuildinfo",
        "log-viewer/tsconfig.tsbuildinfo"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "^5.0.9",
      "fast-uri": "^4.1.2",
      "js-yaml": "^4.3.1",
      "serialize-javascript": "^7.0.5",
      "uuid": "^11.1.1"
    }
  }
}
