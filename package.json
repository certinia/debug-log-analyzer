{
  "name": "lana-ws",
  "private": true,
  "devDependencies": {
    "@apexdevtools/apex-log-parser": "0.3.0",
    "@playwright/test": "^1.64.1",
    "@prettier/plugin-oxc": "^0.2.3",
    "@rolldown/plugin-node-polyfills": "^1.0.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@salesforce/playwright-vscode-ext": "1.7.0",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@vscode/test-web": "^0.0.81",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.15",
    "rollup": "^4.65.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-swc3": "^0.12.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "bump-prerelease": "node ./scripts/pre-release.mjs",
    "build": "node --run typecheck && node --run build:prod",
    "build:rollup": "node --run typecheck && NODE_ENV=production node --run build:dev:rollup",
    "build:dev": "rm -rf lana/out && rolldown -c rolldown.config.ts",
    "build:dev:rollup": "rm -rf lana/out log-viewer/out && rollup -c rollup.config.mjs",
    "build:prod": "NODE_ENV=production node --run build:dev",
    "watch": "rm -rf lana/out && rolldown -w -c rolldown.config.ts",
    "watch:rollup": "rm -rf lana/out log-viewer/out && rollup -w -c rollup.config.mjs",
    "copy:package-docs": "node ./scripts/copy-package-docs.mjs",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json && tsc -p log-viewer/src/grid/core/tsconfig.json",
    "measure": "rolldown -c scripts/measure/rolldown.config.ts && node --expose-gc --max-old-space-size=12288 scripts/measure/out/measure.mjs",
    "bench:grid": "rolldown -c log-viewer/bench/grid/rolldown.config.ts && node scripts/grid-bench/run-bench.mjs",
    "lint": "concurrently -r -g 'oxlint' 'prettier --cache **/*.{ts,css,md,mdx} --check --experimental-cli' 'pnpm run typecheck'",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:e2e:web": "node --run build:prod && playwright test --config=lana/test/playwright/playwright.config.web.ts",
    "serve:web": "pnpm build && tsx lana/test/playwright/web/headlessServer.ts",
    "shots:web": "node --run build:prod && playwright test --config=lana/test/playwright/playwright.config.shots.ts",
    "ci:install": "pnpm install --frozen-lockfile --prefer-offline --ignore-scripts",
    "format": "prettier '**/*.{ts,css,md,mdx}' --cache --write --experimental-cli"
  },
  "lint-staged": {
    "*.{ts,css,md,mdx}": "prettier --cache --write --experimental-cli"
  }
}
