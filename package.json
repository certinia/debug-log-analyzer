{
  "name": "lana-ws",
  "private": true,
  "devDependencies": {
    "@apexdevtools/apex-log-parser": "0.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@prettier/plugin-oxc": "^0.2.3",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@salesforce/playwright-vscode-ext": "^1.7.0",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@vscode/test-web": "^0.0.81",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "rolldown": "^1.2.12",
    "rollup": "^4.63.5",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-swc3": "^0.12.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "bump-prerelease": "node ./scripts/pre-release.mjs",
    "build": "node --run typecheck && NODE_ENV=production node --run build:dev",
    "build:rollup": "node --run typecheck && NODE_ENV=production node --run build:dev:rollup",
    "build:dev": "rm -rf lana/out && rolldown -c rolldown.config.ts",
    "build:dev:rollup": "rm -rf lana/out log-viewer/out && rollup -c rollup.config.mjs",
    "watch": "rm -rf lana/out && rolldown -w -c rolldown.config.ts",
    "watch:rollup": "rm -rf lana/out log-viewer/out && rollup -w -c rollup.config.mjs",
    "copy:package-docs": "node ./scripts/copy-package-docs.mjs",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json",
    "typecheck:tsc6": "tsc6 -b",
    "measure": "rolldown -c scripts/measure/rolldown.config.ts && node --expose-gc --max-old-space-size=12288 scripts/measure/out/measure.mjs",
    "lint": "concurrently -r -g 'eslint . --cache --cache-location node_modules/.cache/eslint/' 'prettier --cache **/*.{ts,css,md,mdx,scss} --check --experimental-cli' 'pnpm run typecheck'",
    "test": "vitest run",
    "test:e2e:web": "pnpm build && playwright test --config=lana/test/playwright/playwright.config.web.ts",
    "serve:web": "pnpm build && tsx lana/test/playwright/web/headlessServer.ts",
    "ci:install": "pnpm install --frozen-lockfile --prefer-offline --ignore-scripts",
    "prettier-format": "prettier '**/*.ts' --cache --write --experimental-cli"
  },
  "lint-staged": {
    "*.{ts,css,md,mdx,scss}": "prettier --cache --write --experimental-cli"
  }
}
